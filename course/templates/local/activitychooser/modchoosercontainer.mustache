{{!
    @template core_course/local/activitychooser/modchoosercontainer

    The activity chooser main container.

    Example context (json):
    {
    }
}}
<div
    class="modchoosercontainer"
    aria-label="{{#str}} activitymodules, core {{/str}}"
    data-region="chooser-container"
>
    <div class="modchooserfilters">
        <div class="searchcontainer mb-3 px-1">
            {{>core_course/local/activitychooser/search}}
        </div>
    </div>
    <div
        class="nav nav-pills modchoosernav d-flex flex-row flex-md-column flex-nowrap gap-2"
        id="activities-{{uniqid}}"
        role="tablist"
    >
        {{#tabs}}
        <a
            class="nav-item nav-link {{#active}}active{{/active}} {{^displayed}} d-none {{/displayed}}"
            id="{{tabId}}-tab-{{uniqid}}"
            data-bs-toggle="tab"
            data-region="{{tabId}}-tab-nav"
            href="#{{tabId}}-{{uniqid}}"
            role="tab"
            aria-controls="{{tabId}}-{{uniqid}}"
            aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}"
            {{^displayed}} disabled="true" {{/displayed}}
        >
            {{tabLabel}}
        </a>
        {{/tabs}}
        <hr>
        {{#purposes}}
        <a class="nav-item nav-link {{#active}}active{{/active}} {{^displayed}} d-none {{/displayed}}"
            id="{{tabId}}-tab-{{uniqid}}"
            data-bs-toggle="tab"
            data-region="{{tabId}}-tab-nav"
            href="#{{tabId}}-{{uniqid}}"
            role="tab"
            aria-controls="{{tabId}}-{{uniqid}}"
            aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}"
            {{^displayed}} disabled="true" {{/displayed}}
        >
            {{tabLabel}}
        </a>
        {{/purposes}}
        <a
            class="nav-item nav-link d-none"
            id="search-tab-{{uniqid}}"
            data-bs-toggle="tab"
            data-region="search-tab-nav"
            href="#search-{{uniqid}}"
            role="tab"
            aria-controls="search-{{uniqid}}"
            aria-selected="false"
            {{^displayed}} disabled="true" {{/displayed}}
        >
            Search
        </a>
    </div>
    <div
        class="modchoosercontent tab-content"
        id="tabbed-activities-{{uniqid}}"
        data-region="tabcontent"
    >
        <div
            class="tab-pane"
            id="search-{{uniqid}}"
            data-region="search"
            role="tabpanel"
            aria-labelledby="search-tab-{{uniqid}}"
            aria-live="polite"
        >
            <div class="searchresultscontainer" data-region="search-results-container" aria-live="polite">
            </div>
        </div>
        {{#tabs}}
        {{>core_course/local/activitychooser/tabcontent}}
        {{/tabs}}
        {{#purposes}}
        {{>core_course/local/activitychooser/tabcontent}}
        {{/purposes}}
    </div>
</div>
