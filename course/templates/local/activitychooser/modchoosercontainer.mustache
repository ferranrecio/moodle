{{!
    @template core_course/local/activitychooser/modchoosercontainer

    The activity chooser main container.

    Example context (json):
    {
        "uniqid": "123abc",
        "tabs": [
            {
                "tabId": "activities",
                "tabLabel": "Activities",
                "active": true,
                "displayed": true,
                "separator": false,
                "items": [
                    {
                        "label": "Option name",
                        "description": "Option description",
                        "urls": {
                            "addoption": "http://addoptionurl.com"
                        },
                        "icon": "<img class='icon' src='http://urltooptionicon' alt='icon'>",
                        "purpose": "content",
                        "branded": 0
                    }
                ]
            },
            {
                "tabId": "resources",
                "tabLabel": "Resources",
                "active": false,
                "displayed": true,
                "separator": true,
                "items": [
                    {
                        "label": "Option name",
                        "description": "Option description",
                        "urls": {
                            "addoption": "http://addoptionurl.com"
                        },
                        "icon": "<img class='icon' src='http://urltooptionicon' alt='icon'>",
                        "purpose": "content",
                        "branded": 0
                    }
                ]
            },
            {
                "tabId": "tools",
                "tabLabel": "Tools",
                "active": false,
                "displayed": false,
                "separator": false,
                "items": [
                    {
                        "label": "Option name",
                        "description": "Option description",
                        "urls": {
                            "addoption": "http://addoptionurl.com"
                        },
                        "icon": "<img class='icon' src='http://urltooptionicon' alt='icon'>",
                        "purpose": "content",
                        "branded": 0
                    }
                ]
            }
        ]
    }
}}
<div
    class="modchoosercontainer"
    aria-label="{{#str}} activitymodules, core {{/str}}"
    data-region="chooser-container"
>
    <div class="modchooserfilters">
        <div class="searchcontainer mb-3 px-1">
            {{>core_course/local/activitychooser/search}}
        </div>
    </div>
    <div
        class="nav nav-pills modchoosernav d-flex flex-row flex-md-column flex-nowrap gap-2"
        id="activities-{{uniqid}}"
        role="tablist"
    >
        {{! Tab navigation items }}
        {{#tabs}}
        <a
            class="nav-item nav-link {{#active}}active{{/active}} {{^displayed}} d-none {{/displayed}}"
            id="{{tabId}}-tab-{{uniqid}}"
            data-bs-toggle="tab"
            data-region="{{tabId}}-tab-nav"
            href="#{{tabId}}-{{uniqid}}"
            role="tab"
            aria-controls="{{tabId}}-{{uniqid}}"
            aria-selected="{{#active}}true{{/active}}{{^active}}false{{/active}}"
            {{^displayed}} disabled="true" {{/displayed}}
        >
            {{tabLabel}}
        </a>
        {{#separator}}<hr>{{/separator}}
        {{/tabs}}
        {{! Hidden search tab navigation item }}
        {{! This is a hidden tab that is used to show the search results. }}
        {{! It is not displayed in the tab navigation. }}
        <a
            class="nav-item nav-link d-none"
            id="search-tab-{{uniqid}}"
            data-bs-toggle="tab"
            data-region="search-tab-nav"
            href="#search-{{uniqid}}"
            role="tab"
            aria-controls="search-{{uniqid}}"
            aria-selected="false"
            {{^displayed}} disabled="true" {{/displayed}}
        >
            Search
        </a>
    </div>
    <div
        class="modchoosercontent tab-content"
        id="tabbed-activities-{{uniqid}}"
        data-region="tabcontent"
    >
        {{! Search results container }}
        <div
            class="tab-pane"
            id="search-{{uniqid}}"
            data-region="search"
            role="tabpanel"
            aria-labelledby="search-tab-{{uniqid}}"
            aria-live="polite"
        >
            <div class="searchresultscontainer" data-region="search-results-container" aria-live="polite">
            </div>
        </div>
        {{! Tab contents }}
        {{#tabs}}
        <div
            class="tab-pane {{#active}}active{{/active}}"
            id="{{tabId}}-{{uniqid}}"
            data-region="{{tabId}}"
            role="tabpanel"
            aria-labelledby="{{tabId}}-tab-{{uniqid}}"
        >
            {{>core_course/local/activitychooser/tabcontent}}
        </div>
        {{/tabs}}
    </div>
</div>
