{{!
    @template mod_peerassign/activity_view

    Main activity view placeholder for peerassign.

    Context variables required for this template:
    * name - Activity name.
    * hasintro - Whether introduction content exists.
    * intro - Formatted activity introduction HTML.
    * uiplaceholder - Placeholder message for future UI.

    Example context (json):
    {
        "name": "Peer review assignment",
        "hasintro": true,
        "intro": "<div class=\"no-overflow\">Intro</div>",
        "uiplaceholder": "Activity interface will be implemented here."
    }
}}
<h2>{{name}}</h2>

{{#hasintro}}
    <div class="generalbox mod_introbox" id="peerassignintro">
        {{{intro}}}
    </div>
{{/hasintro}}

<div class="alert alert-info">{{uiplaceholder}}</div>
