{{!
    @template mod_scorm/attempt_status

    The SCORM attempt status display.

    Example context (json):
    {
        "status": [
            {
                "label": "Grading method",
                "value": "Highest attempt"
            },
            {
                "label": "Attempts allowed",
                "value": "3"
            },
            {
                "label": "Attempts made",
                "value": "2",
                "extrabutton": {
                    "method" : "get",
                    "id": "buttonid-123",
                    "type": "primary",
                    "url" : "#",
                    "tooltip" : "This is a tooltip",
                    "label" : "This is a the button text",
                    "attributes": [
                        {
                        "name": "data-attribute",
                        "value": "yeah"
                        }
                    ]
                }
            }
        ],
        "alert": {
            "type": "info",
            "message": "This is an informational message."
        }
    }
}}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="h5 mb-0">{{#str}} summary {{/str}}</h3>
    </div>
    <div class="card-body">
        <div class="row">
            {{#status}}
            <div class="col-12 mb-2 d-flex justify-content-between align-items-center border-bottom pb-2">
                <span class="fw-semibold">{{label}}</span>
                <span>
                    {{#hasbutton}}
                    <span class="d-flex align-items-center gap-4">
                        {{#extrabutton}}
                            {{>core/single_button}}
                        {{/extrabutton}}
                        {{value}}
                    </span>
                    {{/hasbutton}}
                    {{^hasbutton}}
                        {{value}}
                    {{/hasbutton}}
                </span>
            </div>
            {{/status}}
        </div>
        {{#alert}}
            <div class="alert alert-{{type}} mt-2 mb-0" role="alert">
                {{{message}}}
            </div>
        {{/alert}}
    </div>
</div>
