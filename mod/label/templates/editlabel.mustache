{{!
    @template mod_label/editlabel

    Example context (json):
    {
        "cmid": 123,
        "label": "Edit",
        "title": "Edit Label in Section 1",
        "class": "btn btn-secondary-outline"
    }
}}
<button class="{{class}}"
    data-mdl-label-action="edit"
    data-mdl-label-cmid="{{cmid}}"
    title="{{title}}"
>
    {{#pix}}i/edit{{/pix}}
    {{label}}
</button>
{{#js}}
require(['mod_label/editlabel'], (editor) => {
    editor.init();
});
{{/js}}
